<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/1.%20Prefabs/QuizMenu/Style_PC.uss?fileID=7433441132597879392&amp;guid=2a25d9aa4030f1f42a59a0d75a5e1857&amp;type=3#Style_PC"/>
    <Style src="project://database/Assets/1.%20Prefabs/QuizMenu/Style_Mobile.uss?fileID=7433441132597879392&amp;guid=805c508d13f039945a26e84fa781adcf&amp;type=3#Style_Mobile"/>
    <ui:ScrollView name="StartScreen" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Hidden" style="display: flex; visibility: visible; overflow: visible; align-items: stretch; justify-content: flex-start; background-color: rgb(255, 255, 255); flex-shrink: 0; flex-grow: 0; width: 100%; height: 100%;">
        <ui:VisualElement name="Background" style="flex-grow: 1; padding-top: 5%; padding-right: 5%; padding-bottom: 5%; padding-left: 5%; width: 100%; height: 100%; align-self: stretch; justify-content: flex-start; align-content: auto; align-items: center;">
            <ui:Label text="Warning" name="Warning" class="Title" style="align-self: center; color: rgb(255, 0, 0); visibility: visible; -unity-text-generator: advanced; -unity-text-auto-size: best-fit 10px 30px;"/>
            <ui:Label text="Content" name="ContentTitle" class="Title" style="flex-wrap: nowrap; -unity-text-align: middle-center;"/>
            <ui:Foldout text="Content" name="Content" toggle-on-label-click="true" value="true" enabled="true" style="flex-grow: 1; flex-shrink: 0; width: 100%; margin-top: 5%; margin-right: 5%; margin-bottom: 5%; margin-left: 5%;">
                <ui:VisualElement name="Content" class="ToggleList" style="flex-grow: 1; flex-direction: column; flex-wrap: nowrap; flex-shrink: 0; width: 100%; align-items: stretch; justify-content: center; align-self: center; align-content: auto; margin-top: 3%; padding-top: 0%; margin-bottom: 0%;"/>
            </ui:Foldout>
            <ui:VisualElement name="Options" class="ToggleList" style="flex-grow: 1; flex-direction: column; flex-wrap: nowrap; flex-shrink: 0; width: 100%; align-items: stretch; justify-content: flex-start; align-self: center; align-content: auto; margin-top: 3%; margin-bottom: 0%;">
                <ui:Label text="Options" name="OptionsText" class="Title" style="flex-wrap: nowrap; -unity-text-align: upper-center;"/>
            </ui:VisualElement>
            <ui:Foldout text="Adventure Options" name="AdventureOptions" value="true" style="flex-shrink: 0; flex-grow: 1; width: 100%; padding-top: 0%; padding-right: 0%; padding-bottom: 0%; padding-left: 0%; margin-top: 5%; margin-right: 5%; margin-bottom: 5%; margin-left: 5%;">
                <ui:VisualElement name="AdventureOptions" class="ToggleList" style="flex-grow: 1; flex-direction: column; flex-wrap: nowrap; flex-shrink: 0; width: 100%; align-items: stretch; justify-content: flex-start; align-self: center; align-content: auto; margin-top: 3%; margin-bottom: 3%;">
                    <ui:Label text="Adventure Options" name="OptionsText" class="Title" style="flex-wrap: nowrap;"/>
                    <ui:IntegerField label="Adventure Length&#10;" value="4" name="AdventureLength" keyboard-type="NumberPad" style="width: 100%; align-self: center; -unity-font-definition: url(&quot;project://database/Assets/4.%20Art/Fonts/EnkaDotGothic24.ttf?fileID=12800000&amp;guid=3f1f45f3d7e637345b21c4ce748e2d38&amp;type=3#EnkaDotGothic24&quot;);"/>
                    <ui:IntegerField label="Starting Health&#10;" value="3" name="StartingHealth" keyboard-type="NumberPad" style="width: 100%; align-self: center; -unity-font-definition: url(&quot;project://database/Assets/4.%20Art/Fonts/EnkaDotGothic24.ttf?fileID=12800000&amp;guid=3f1f45f3d7e637345b21c4ce748e2d38&amp;type=3#EnkaDotGothic24&quot;);"/>
                </ui:VisualElement>
            </ui:Foldout>
            <ui:Button name="Adventure" double-click-selects-word="false" triple-click-selects-line="false" display-tooltip-when-elided="false" text="Set Forth" class="Button Title" style="flex-grow: 0; flex-shrink: 0; margin-top: 1%; margin-right: 1%; margin-bottom: 1%; margin-left: 1%; width: 75%; align-items: center; justify-content: center; align-self: center; padding-top: 2%; padding-right: 2%; padding-bottom: 2%; padding-left: 2%; font-size: 30%; -unity-font-style: bold; text-overflow: clip;"/>
            <ui:Foldout text="QuizOptions&#10;" name="QuizOptions" toggle-on-label-click="true" value="true" enabled="false" style="flex-grow: 1; flex-shrink: 0; width: 100%; padding-top: 0%; padding-right: 0%; padding-bottom: 0%; padding-left: 0%; margin-top: 5%; margin-right: 5%; margin-bottom: 5%; margin-left: 5%; display: none;">
                <ui:VisualElement name="Meanings" class="ToggleList" style="margin-top: 3%; flex-grow: 1; flex-shrink: 0;">
                    <ui:Label text="Meanings" name="MeaningsTitle" class="Title" style="flex-grow: 0; flex-shrink: 1;"/>
                </ui:VisualElement>
                <ui:VisualElement name="VerbForms" class="ToggleList" style="margin-top: 3%; flex-shrink: 0; flex-grow: 1;">
                    <ui:Label text="Verb Forms&#10;" name="VerbFormsTitle" class="Title" style="flex-grow: 0; flex-shrink: 1;"/>
                </ui:VisualElement>
                <ui:VisualElement name="AdjectiveForms" class="ToggleList" style="flex-grow: 1; flex-direction: column; flex-wrap: nowrap; flex-shrink: 0; width: 100%; align-items: stretch; justify-content: center; align-self: center; align-content: auto; margin-top: 3%;">
                    <ui:Label text="Adjective Forms&#10;" name="AdjectiveFormsTitle" class="Title" style="flex-wrap: nowrap;"/>
                </ui:VisualElement>
                <ui:VisualElement name="NounForms" class="ToggleList" style="flex-grow: 1; flex-direction: column; flex-wrap: nowrap; flex-shrink: 0; width: 100%; align-items: stretch; justify-content: center; align-self: center; align-content: auto; margin-top: 3%;">
                    <ui:Label text="Noun Forms" name="NounFormsTitle" class="Title" style="flex-wrap: nowrap;"/>
                </ui:VisualElement>
                <ui:IntegerField label="Number of Questions" value="10" name="QuestionCount" keyboard-type="NumberPad" style="width: 100%; align-self: center; -unity-font-definition: url(&quot;project://database/Assets/4.%20Art/Fonts/EnkaDotGothic24.ttf?fileID=12800000&amp;guid=3f1f45f3d7e637345b21c4ce748e2d38&amp;type=3#EnkaDotGothic24&quot;);"/>
            </ui:Foldout>
            <ui:VisualElement name="Spacer" enabled="false" style="flex-grow: 1; height: 10%; flex-shrink: 0; align-items: auto; align-self: auto; flex-direction: column; display: none;"/>
            <ui:Button name="Start" double-click-selects-word="false" triple-click-selects-line="false" display-tooltip-when-elided="false" text="Begin Quiz" enabled="false" class="Button Title" style="flex-grow: 1; flex-shrink: 0; margin-top: 1%; margin-right: 1%; margin-bottom: 1%; margin-left: 1%; width: 75%; align-items: center; justify-content: center; align-self: center; padding-top: 2%; padding-right: 2%; padding-bottom: 2%; padding-left: 2%; font-size: 30%; -unity-font-style: bold; text-overflow: clip; display: none;"/>
        </ui:VisualElement>
    </ui:ScrollView>
</ui:UXML>
