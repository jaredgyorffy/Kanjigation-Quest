    <ui:VisualElement name="Toggle" enabled="true" style="flex-grow: 1; align-items: flex-start; justify-content: space-between; align-content: flex-start; align-self: flex-start; flex-shrink: 0; flex-direction: row-reverse; width: 100%; font-size: 14%; margin-top: 0%; margin-right: 0%; margin-bottom: 0%; margin-left: 0%; padding-top: 2%; padding-right: 0; padding-bottom: 2%; padding-left: 0; height: 100%;">
        <ui:Toggle name="Toggle" style="width: auto; flex-grow: 0; align-items: flex-start; justify-content: center; align-self: center; flex-direction: row; align-content: center; padding-right: 5%; padding-left: 5%; white-space: normal; font-size: 2%;"/>
        <ui:VisualElement style="flex-grow: 1; background-color: rgb(0, 0, 0); flex-shrink: 0; align-self: center; align-items: center; justify-content: center; align-content: flex-start; background-size: 100% 5%; height: 5%;"/>
        <ui:Label text="Toggle" name="Label" class="Paragraph" style="justify-content: center; align-self: center; align-items: center; margin-top: 1%; margin-right: 1%; margin-bottom: 1%; margin-left: 1%; padding-top: 0; padding-right: 0%; padding-bottom: 0; padding-left: 0%; font-size: 15%; white-space: normal; opacity: 1; text-overflow: clip; -unity-text-align: middle-left; flex-grow: 0; flex-shrink: 1; flex-direction: column; flex-wrap: nowrap; width: auto; align-content: flex-start;"/>
    </ui:VisualElement>
